$C = "../PlotsCommon.ui";
$Sounds = "../PlotsSounds.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer #RightContainer {
  @CloseButton = true;
  Anchor: (Width: 674, Height: 554);

  #Title {
    Group #ContainerDecorationTop {
      Visible: false;
    }

    $C.@Title #RightTitle { @Text = "PLOT WORLDS"; }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Full: 16);

    // Delete confirmation bar (shown only when a deletion is pending).
    Group #WaConfirmBar {
      Anchor: (Horizontal: 0, Height: 40, Bottom: 8);
      LayoutMode: Left;
      Background: (Color: #3a2330);
      Padding: (Left: 10, Right: 6, Vertical: 4);
      Visible: false;

      Label #WaConfirmText {
        Anchor: (Vertical: 0);
        FlexWeight: 1;
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffd0d0, VerticalAlignment: Center);
        Text: "";
      }
      $C.@SmallSecondaryTextButton #WaConfirmNo { @Anchor = (Width: 90); Text: "Cancel"; }
      Group { Anchor: (Width: 6); }
      $C.@SmallSecondaryTextButton #WaConfirmYes { @Anchor = (Width: 90); Text: "Delete"; }
    }

    Label #WaEmpty {
      Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #d6a6a6);
      Text: "No plot worlds configured.";
      Visible: false;
    }

    Group {
      Anchor: (Horizontal: 0, Bottom: 6);
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      Group #WaRow0 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #WaRowName0 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #WaRowDelete0 { @Anchor = (Width: 100); Text: "Delete"; } }
      Group #WaRow1 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #WaRowName1 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #WaRowDelete1 { @Anchor = (Width: 100); Text: "Delete"; } }
      Group #WaRow2 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #WaRowName2 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #WaRowDelete2 { @Anchor = (Width: 100); Text: "Delete"; } }
      Group #WaRow3 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #WaRowName3 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #WaRowDelete3 { @Anchor = (Width: 100); Text: "Delete"; } }
      Group #WaRow4 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #WaRowName4 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #WaRowDelete4 { @Anchor = (Width: 100); Text: "Delete"; } }
      Group #WaRow5 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #WaRowName5 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #WaRowDelete5 { @Anchor = (Width: 100); Text: "Delete"; } }
      Group #WaRow6 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #WaRowName6 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #WaRowDelete6 { @Anchor = (Width: 100); Text: "Delete"; } }
      Group #WaRow7 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #WaRowName7 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #WaRowDelete7 { @Anchor = (Width: 100); Text: "Delete"; } }
      Group #WaRow8 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #WaRowName8 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #WaRowDelete8 { @Anchor = (Width: 100); Text: "Delete"; } }
      Group #WaRow9 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #WaRowName9 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #WaRowDelete9 { @Anchor = (Width: 100); Text: "Delete"; } }
    }

    Group {
      Anchor: (Horizontal: 0, Height: 32, Bottom: 6);
      LayoutMode: Left;

      $C.@SmallSecondaryTextButton #WaPrev {
        @Anchor = (Width: 120);
        Text: "Prev";
      }

      Label #WaPageLabel {
        Anchor: (Vertical: 0);
        FlexWeight: 1;
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #cbd9e8, HorizontalAlignment: Center, VerticalAlignment: Center);
        Text: "";
      }

      $C.@SmallSecondaryTextButton #WaNext {
        @Anchor = (Width: 120);
        Text: "Next";
      }
    }

    Group {
      Anchor: (Horizontal: 0, Height: 44, Bottom: 6);
      LayoutMode: Left;

      $C.@TextButton #WaCreate {
        FlexWeight: 1;
        Text: "Create World";
      }
      Group { Anchor: (Width: 8); }
      $C.@SecondaryTextButton #WaBack {
        FlexWeight: 1;
        Text: "Back";
      }
    }
  }
}
