$C = "../PlotsCommon.ui";
$Sounds = "../PlotsSounds.ui";

$C.@PageOverlay {}

$C.@Container {
  @CloseButton = true;
  Anchor: (Width: 1000, Height: 620);

  #Title {
    $C.@Title #RightTitle { @Text = "ADMIN DASHBOARD"; }
  }

  #Content {
    LayoutMode: Left;
    Padding: (Full: 8);

    // === Sidebar (aero-style text nav) ===
    // Same nav rail as PlotMenu.ui: panel background over the whole column so the
    // space under the tabs belongs to the rail.
    Group #Sidebar {
      Anchor: (Width: 170, Vertical: 0);
      LayoutMode: Top;
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4, Color: #0f1822);
      Padding: (Vertical: 8, Horizontal: 6);

      $C.@AeroNavButton #NavSettings { @Text = "Settings"; }
      $C.@AeroNavButtonActive #NavSettingsActive { @Text = "Settings"; Visible: false; }
      $C.@AeroNavButton #NavPlots { @Text = "Plots"; }
      $C.@AeroNavButtonActive #NavPlotsActive { @Text = "Plots"; Visible: false; }
      $C.@AeroNavButton #NavStats { @Text = "Stats"; }
      $C.@AeroNavButtonActive #NavStatsActive { @Text = "Stats"; Visible: false; }
      $C.@AeroNavButton #NavWorlds { @Text = "Worlds"; }

      Group { FlexWeight: 1; }
    }

    Group { Anchor: (Width: 14); }

    // === Main content ===
    Group #Main {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Top;
      Padding: (Full: 6);

      Label #AdminPanelTitle {
        Anchor: (Horizontal: 0, Height: 24);
        Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, HorizontalAlignment: Start);
        Text: "";
      }
      Group #AdminTitleRule { Anchor: (Horizontal: 0, Height: 1, Top: 8, Bottom: 10); Background: (Color: #7a9cc655); }

      Label #PermNotice {
        Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffd6c8, HorizontalAlignment: Center);
        Text: "";
        Visible: false;
      }

      // Panel host: takes whatever vertical space is left below the title, so the
      // panels (and their scroll areas + footer buttons) stay inside the modal.
      Group #PanelHost {
        Anchor: (Horizontal: 0);
        FlexWeight: 1;
        LayoutMode: Top;

        // ===== SETTINGS PANEL =====
        Group #PanelSettings {
          Visible: true;
          Anchor: (Horizontal: 0, Vertical: 0);
          LayoutMode: Top;

          Group {
            Anchor: (Horizontal: 0, Bottom: 8);
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;

            Label #SettingsEditableLabel {
              Anchor: (Horizontal: 0, Height: 22, Bottom: 4);
              Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #afc2c3, RenderBold: true);
              Text: "EDITABLE";
            }

            Group {
              Anchor: (Horizontal: 0, Height: 60, Bottom: 6); LayoutMode: Top; Padding: (Horizontal: 6);
              Label #SetPlotSizeXLabel { Text: "Plot Size X"; Style: (FontSize: 13, TextColor: #b2c1d0); Anchor: (Horizontal: 0, Height: 16, Bottom: 4); }
              $C.@TextField #SetPlotSizeX { @Anchor = (Horizontal: 0); }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 60, Bottom: 6); LayoutMode: Top; Padding: (Horizontal: 6);
              Label #SetPlotSizeZLabel { Text: "Plot Size Z"; Style: (FontSize: 13, TextColor: #b2c1d0); Anchor: (Horizontal: 0, Height: 16, Bottom: 4); }
              $C.@TextField #SetPlotSizeZ { @Anchor = (Horizontal: 0); }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 60, Bottom: 6); LayoutMode: Top; Padding: (Horizontal: 6);
              Label #SetRoadSizeXLabel { Text: "Road Size X"; Style: (FontSize: 13, TextColor: #b2c1d0); Anchor: (Horizontal: 0, Height: 16, Bottom: 4); }
              $C.@TextField #SetRoadSizeX { @Anchor = (Horizontal: 0); }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 60, Bottom: 6); LayoutMode: Top; Padding: (Horizontal: 6);
              Label #SetRoadSizeZLabel { Text: "Road Size Z"; Style: (FontSize: 13, TextColor: #b2c1d0); Anchor: (Horizontal: 0, Height: 16, Bottom: 4); }
              $C.@TextField #SetRoadSizeZ { @Anchor = (Horizontal: 0); }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 60, Bottom: 6); LayoutMode: Top; Padding: (Horizontal: 6);
              Label #SetDefaultNameLabel { Text: "Default Name"; Style: (FontSize: 13, TextColor: #b2c1d0); Anchor: (Horizontal: 0, Height: 16, Bottom: 4); }
              $C.@TextField #SetDefaultName { @Anchor = (Horizontal: 0); }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 60, Bottom: 6); LayoutMode: Top; Padding: (Horizontal: 6);
              Label #SetMaxPlotsLabel { Text: "Max Plots"; Style: (FontSize: 13, TextColor: #b2c1d0); Anchor: (Horizontal: 0, Height: 16, Bottom: 4); }
              $C.@TextField #SetMaxPlots { @Anchor = (Horizontal: 0); }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 60, Bottom: 6); LayoutMode: Top; Padding: (Horizontal: 6);
              Label #SetMaxLimitLabel { Text: "Max Limit"; Style: (FontSize: 13, TextColor: #b2c1d0); Anchor: (Horizontal: 0, Height: 16, Bottom: 4); }
              $C.@TextField #SetMaxLimit { @Anchor = (Horizontal: 0); }
            }
            // Vertical padding leaves a 22-tall content box — the fixed @CheckBox size.
            Group {
              Anchor: (Horizontal: 0, Height: 34, Bottom: 6); LayoutMode: Left; Padding: (Horizontal: 6, Vertical: 6);
              Label #SetHologramLabel { Text: "Holograms"; Style: (FontSize: 13, TextColor: #b2c1d0, VerticalAlignment: Center); Anchor: (Vertical: 0); FlexWeight: 1; }
              $C.@CheckBox #SetHologram { Value: false; }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 34, Bottom: 6); LayoutMode: Left; Padding: (Horizontal: 6, Vertical: 6);
              Label #SetEconomyLabel { Text: "Economy"; Style: (FontSize: 13, TextColor: #b2c1d0, VerticalAlignment: Center); Anchor: (Vertical: 0); FlexWeight: 1; }
              $C.@CheckBox #SetEconomy { Value: false; }
            }

            Label #SettingsNote {
              Anchor: (Horizontal: 0, Height: 30, Bottom: 8);
              Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8aa0b4, Wrap: true);
              Text: "";
            }

            Label #SettingsReadonlyLabel {
              Anchor: (Horizontal: 0, Height: 22, Bottom: 4);
              Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #afc2c3, RenderBold: true);
              Text: "READ-ONLY";
            }

            Group {
              Anchor: (Horizontal: 0);
              LayoutMode: Top;
              Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4, Color: #0f1822);
              Padding: (Full: 10);

              Group {
                Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
                Label #SetWorldNameLabel { Text: "World Name:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
                Label #SetWorldName { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              }
              Group {
                Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
                Label #SetManagedWorldLabel { Text: "Managed World:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
                Label #SetManagedWorld { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              }
            }
          }

          // @TextButton forces Height: @DefaultButtonHeight (44) after spreading @Anchor —
          // a height declared here would be ignored, so only spacing is set.
          $C.@TextButton #BtnSaveSettings {
            @Anchor = (Horizontal: 0, Bottom: 2);
            Text: "Save Settings";
          }
        }

        // ===== PLOTS PANEL =====
        Group #PanelPlots {
          Visible: false;
          Anchor: (Horizontal: 0, Vertical: 0);
          LayoutMode: Top;

          Label #AdmEmpty {
            Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #d6a6a6);
            Text: "No plots claimed.";
            Visible: false;
          }

          // Transfer sub-panel (toggled visible while transferring).
          Group #AdmTransferPanel {
            Visible: false;
            Anchor: (Horizontal: 0, Bottom: 8);
            LayoutMode: Top;
            Background: (Color: #16202d);
            Padding: (Full: 8);

            Label #AdmTransferLabel {
              Anchor: (Horizontal: 0, Height: 18, Bottom: 6);
              Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #cbd9e8, Wrap: true);
              Text: "";
            }

            // @TextField forces Height 38 and @SmallSecondaryTextButton forces 32, so the
            // bar is 38 tall and each button sits in a Middle group that centres it.
            Group {
              Anchor: (Horizontal: 0, Height: 38);
              LayoutMode: Left;

              $C.@TextField #AdmTransferField {
                @Anchor = (Vertical: 0);
                FlexWeight: 1;
              }

              Group { Anchor: (Width: 8); }

              Group {
                Anchor: (Width: 120, Vertical: 0);
                LayoutMode: Middle;

                $C.@SmallSecondaryTextButton #AdmTransferSubmit {
                  @Anchor = (Horizontal: 0);
                  Text: "Transfer";
                }
              }

              Group { Anchor: (Width: 6); }

              Group {
                Anchor: (Width: 100, Vertical: 0);
                LayoutMode: Middle;

                $C.@SmallSecondaryTextButton #AdmTransferCancel {
                  @Anchor = (Horizontal: 0);
                  Text: "Cancel";
                }
              }
            }
          }

          Group {
            Anchor: (Horizontal: 0, Bottom: 6);
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;

            Group #AdmRow0 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #AdmRowName0 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner0 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid0 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp0 { @Anchor = (Width: 70); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer0 { @Anchor = (Width: 90); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete0 { @Anchor = (Width: 80); Text: "Delete"; } }
            Group #AdmRow1 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #AdmRowName1 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner1 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid1 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp1 { @Anchor = (Width: 70); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer1 { @Anchor = (Width: 90); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete1 { @Anchor = (Width: 80); Text: "Delete"; } }
            Group #AdmRow2 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #AdmRowName2 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner2 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid2 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp2 { @Anchor = (Width: 70); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer2 { @Anchor = (Width: 90); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete2 { @Anchor = (Width: 80); Text: "Delete"; } }
            Group #AdmRow3 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #AdmRowName3 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner3 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid3 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp3 { @Anchor = (Width: 70); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer3 { @Anchor = (Width: 90); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete3 { @Anchor = (Width: 80); Text: "Delete"; } }
            Group #AdmRow4 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #AdmRowName4 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner4 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid4 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp4 { @Anchor = (Width: 70); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer4 { @Anchor = (Width: 90); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete4 { @Anchor = (Width: 80); Text: "Delete"; } }
            Group #AdmRow5 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #AdmRowName5 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner5 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid5 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp5 { @Anchor = (Width: 70); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer5 { @Anchor = (Width: 90); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete5 { @Anchor = (Width: 80); Text: "Delete"; } }
            Group #AdmRow6 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #AdmRowName6 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner6 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid6 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp6 { @Anchor = (Width: 70); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer6 { @Anchor = (Width: 90); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete6 { @Anchor = (Width: 80); Text: "Delete"; } }
            Group #AdmRow7 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #AdmRowName7 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner7 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid7 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp7 { @Anchor = (Width: 70); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer7 { @Anchor = (Width: 90); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete7 { @Anchor = (Width: 80); Text: "Delete"; } }
            Group #AdmRow8 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #AdmRowName8 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner8 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid8 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp8 { @Anchor = (Width: 70); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer8 { @Anchor = (Width: 90); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete8 { @Anchor = (Width: 80); Text: "Delete"; } }
            Group #AdmRow9 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6, Vertical: 3); Visible: false; Label #AdmRowName9 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner9 { Anchor: (Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid9 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp9 { @Anchor = (Width: 70); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer9 { @Anchor = (Width: 90); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete9 { @Anchor = (Width: 80); Text: "Delete"; } }
          }

          Group {
            Anchor: (Horizontal: 0, Height: 32);
            LayoutMode: Left;

            $C.@SmallSecondaryTextButton #AdmPrev {
              @Anchor = (Width: 120);
              Text: "Prev";
            }

            Label #AdmPageLabel {
              Anchor: (Vertical: 0);
              FlexWeight: 1;
              Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #cbd9e8, HorizontalAlignment: Center, VerticalAlignment: Center);
              Text: "";
            }

            $C.@SmallSecondaryTextButton #AdmNext {
              @Anchor = (Width: 120);
              Text: "Next";
            }
          }
        }

        // ===== STATS PANEL =====
        Group #PanelStats {
          Visible: false;
          Anchor: (Horizontal: 0, Vertical: 0);
          LayoutMode: Top;

          Group {
            Anchor: (Horizontal: 0, Bottom: 12);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4, Color: #0f1822);
            Padding: (Full: 10);

            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label #StatTotalLabel { Text: "Total Plots:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #StatTotal { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label #StatClaimedLabel { Text: "Claimed:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #StatClaimed { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label #StatUnclaimedLabel { Text: "Unclaimed:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #StatUnclaimed { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label #StatOwnersLabel { Text: "Distinct Owners:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #StatOwners { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
          }

          Label #StatTopLabel {
            Anchor: (Horizontal: 0, Height: 22, Bottom: 4);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #afc2c3, RenderBold: true);
            Text: "TOP OWNERS";
          }

          Label #StatTopEmpty {
            Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #d6a6a6);
            Text: "No data.";
            Visible: false;
          }

          Group {
            Anchor: (Horizontal: 0, Bottom: 4);
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;

            Group #StatTopRow0 { Visible: false; Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6); Label #StatTopName0 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center); Text: ""; } Label #StatTopCount0 { Anchor: (Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9fb3c6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Text: ""; } }
