$C = "../PlotsCommon.ui";
$Sounds = "../PlotsSounds.ui";

@AdmTabBase = TabStyleState(
  Background: "../Common/Tab.png",
  Overlay: "../Common/TabOverlay.png",
  IconAnchor: (Width: 40, Height: 40),
  Anchor: (Width: 82, Height: 62, Right: 5, Bottom: -10)
);
@AdmTopTabAnchor = Anchor(Width: 82, Height: 62, Right: 5, Bottom: -10);
@AdmTopTabsStyle = TabNavigationStyle(
  TabStyle: (
    Default: @AdmTabBase,
    Hovered: (...@AdmTabBase, Anchor: (...@AdmTopTabAnchor, Bottom: -4)),
    Pressed: (...@AdmTabBase, Anchor: (...@AdmTopTabAnchor, Bottom: -6))
  ),
  SelectedTabStyle: (
    Default: (
      ...@AdmTabBase,
      Anchor: (...@AdmTopTabAnchor, Bottom: -1),
      IconAnchor: (Width: 40, Height: 40),
      Overlay: "../Common/TabSelectedOverlay.png"
    )
  )
);

$C.@PageOverlay {}

Group #Root {
  LayoutMode: Left;
  Anchor: (Width: 760, Height: 560);

  Group #LeftSide {
    LayoutMode: Top;
    Anchor: (Width: 78);

    TabNavigation #TabNav {
      Anchor: (Width: 78, Top: 0, Bottom: 0);
      Style: @AdmTopTabsStyle;
      SelectedTab: "Settings";

      TabButton #TabSettings {
        Icon: "../plots_icons/pen.png";
        TooltipText: "Settings";
        Id: "Settings";
      }

      TabButton #TabPlots {
        Icon: "../plots_icons/check.png";
        TooltipText: "Plots";
        Id: "Plots";
      }

      TabButton #TabStats {
        Icon: "../plots_icons/eye.png";
        TooltipText: "Stats";
        Id: "Stats";
      }
    }
  }

  Group { Anchor: (Width: 8); }

  $C.@DecoratedContainer #RightContainer {
    @CloseButton = true;
    Anchor: (Width: 674, Height: 554);

    #Title {
      Group #ContainerDecorationTop {
        Visible: false;
      }

      $C.@Title #RightTitle { @Text = "ADMIN DASHBOARD"; }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #PermNotice {
        Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffd6c8, HorizontalAlignment: Center);
        Text: "";
        Visible: false;
      }

      // ===== SETTINGS PANEL =====
      Group #PanelSettings {
        Visible: true;
        Anchor: (Horizontal: 0, Vertical: 0);
        LayoutMode: Top;

        Group {
          Anchor: (Horizontal: 0, Bottom: 8);
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;

          Label {
            Anchor: (Horizontal: 0, Height: 22, Bottom: 4);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #afc2c3, RenderBold: true);
            Text: "EDITABLE";
          }

          Group {
            Anchor: (Horizontal: 0, Height: 34, Bottom: 6); LayoutMode: Left; Padding: (Horizontal: 6);
            Label { Text: "Plot Size X"; Style: (FontSize: 13, TextColor: #b2c1d0, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            $C.@TextField #SetPlotSizeX { @Anchor = (Width: 120, Vertical: 0); }
          }
          Group {
            Anchor: (Horizontal: 0, Height: 34, Bottom: 6); LayoutMode: Left; Padding: (Horizontal: 6);
            Label { Text: "Plot Size Z"; Style: (FontSize: 13, TextColor: #b2c1d0, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            $C.@TextField #SetPlotSizeZ { @Anchor = (Width: 120, Vertical: 0); }
          }
          Group {
            Anchor: (Horizontal: 0, Height: 34, Bottom: 6); LayoutMode: Left; Padding: (Horizontal: 6);
            Label { Text: "Road Size X"; Style: (FontSize: 13, TextColor: #b2c1d0, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            $C.@TextField #SetRoadSizeX { @Anchor = (Width: 120, Vertical: 0); }
          }
          Group {
            Anchor: (Horizontal: 0, Height: 34, Bottom: 6); LayoutMode: Left; Padding: (Horizontal: 6);
            Label { Text: "Road Size Z"; Style: (FontSize: 13, TextColor: #b2c1d0, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            $C.@TextField #SetRoadSizeZ { @Anchor = (Width: 120, Vertical: 0); }
          }

          Label #SettingsNote {
            Anchor: (Horizontal: 0, Height: 30, Bottom: 8);
            Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8aa0b4, Wrap: true);
            Text: "";
          }

          Label {
            Anchor: (Horizontal: 0, Height: 22, Bottom: 4);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #afc2c3, RenderBold: true);
            Text: "READ-ONLY";
          }

          Group {
            Anchor: (Horizontal: 0);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4, Color: #0f1822);
            Padding: (Full: 10);

            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label { Text: "World Name:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #SetWorldName { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label { Text: "Managed World:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #SetManagedWorld { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label { Text: "Default Name:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #SetDefaultName { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label { Text: "Max Plots:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #SetMaxPlots { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label { Text: "Max Limit:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #SetMaxLimit { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label { Text: "Holograms:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #SetHologram { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
            Group {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
              Label { Text: "Economy:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
              Label #SetEconomy { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            }
          }
        }

        $C.@TextButton #BtnSaveSettings {
          @Anchor = (Horizontal: 0, Height: 40, Bottom: 2);
          Text: "Save Settings";
        }
      }

      // ===== PLOTS PANEL =====
      Group #PanelPlots {
        Visible: false;
        Anchor: (Horizontal: 0, Vertical: 0);
        LayoutMode: Top;

        Label #AdmEmpty {
          Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #d6a6a6);
          Text: "No plots claimed.";
          Visible: false;
        }

        // Transfer sub-panel (toggled visible while transferring).
        Group #AdmTransferPanel {
          Visible: false;
          Anchor: (Horizontal: 0, Bottom: 8);
          LayoutMode: Top;
          Background: (Color: #16202d);
          Padding: (Full: 8);

          Label #AdmTransferLabel {
            Anchor: (Horizontal: 0, Height: 18, Bottom: 6);
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #cbd9e8, Wrap: true);
            Text: "";
          }

          Group {
            Anchor: (Horizontal: 0, Height: 34);
            LayoutMode: Left;

            $C.@TextField #AdmTransferField {
              @Anchor = (Vertical: 0);
              FlexWeight: 1;
            }

            Group { Anchor: (Width: 8); }

            $C.@SmallSecondaryTextButton #AdmTransferSubmit {
              @Anchor = (Width: 120, Vertical: 0);
              Text: "Transfer";
            }

            Group { Anchor: (Width: 6); }

            $C.@SmallSecondaryTextButton #AdmTransferCancel {
              @Anchor = (Width: 100, Vertical: 0);
              Text: "Cancel";
            }
          }
        }

        Group {
          Anchor: (Horizontal: 0, Bottom: 6);
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;

          Group #AdmRow0 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6); Visible: false; Label #AdmRowName0 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner0 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid0 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp0 { @Anchor = (Width: 70, Height: 28); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer0 { @Anchor = (Width: 90, Height: 28); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete0 { @Anchor = (Width: 80, Height: 28); Text: "Delete"; } }
          Group #AdmRow1 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6); Visible: false; Label #AdmRowName1 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner1 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid1 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp1 { @Anchor = (Width: 70, Height: 28); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer1 { @Anchor = (Width: 90, Height: 28); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete1 { @Anchor = (Width: 80, Height: 28); Text: "Delete"; } }
          Group #AdmRow2 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6); Visible: false; Label #AdmRowName2 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner2 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid2 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp2 { @Anchor = (Width: 70, Height: 28); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer2 { @Anchor = (Width: 90, Height: 28); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete2 { @Anchor = (Width: 80, Height: 28); Text: "Delete"; } }
          Group #AdmRow3 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6); Visible: false; Label #AdmRowName3 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner3 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid3 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp3 { @Anchor = (Width: 70, Height: 28); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer3 { @Anchor = (Width: 90, Height: 28); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete3 { @Anchor = (Width: 80, Height: 28); Text: "Delete"; } }
          Group #AdmRow4 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6); Visible: false; Label #AdmRowName4 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner4 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid4 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp4 { @Anchor = (Width: 70, Height: 28); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer4 { @Anchor = (Width: 90, Height: 28); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete4 { @Anchor = (Width: 80, Height: 28); Text: "Delete"; } }
          Group #AdmRow5 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6); Visible: false; Label #AdmRowName5 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner5 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid5 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp5 { @Anchor = (Width: 70, Height: 28); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer5 { @Anchor = (Width: 90, Height: 28); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete5 { @Anchor = (Width: 80, Height: 28); Text: "Delete"; } }
          Group #AdmRow6 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6); Visible: false; Label #AdmRowName6 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner6 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid6 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp6 { @Anchor = (Width: 70, Height: 28); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer6 { @Anchor = (Width: 90, Height: 28); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete6 { @Anchor = (Width: 80, Height: 28); Text: "Delete"; } }
          Group #AdmRow7 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6); Visible: false; Label #AdmRowName7 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner7 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid7 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp7 { @Anchor = (Width: 70, Height: 28); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer7 { @Anchor = (Width: 90, Height: 28); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete7 { @Anchor = (Width: 80, Height: 28); Text: "Delete"; } }
          Group #AdmRow8 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6); Visible: false; Label #AdmRowName8 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner8 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid8 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp8 { @Anchor = (Width: 70, Height: 28); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer8 { @Anchor = (Width: 90, Height: 28); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete8 { @Anchor = (Width: 80, Height: 28); Text: "Delete"; } }
          Group #AdmRow9 { Anchor: (Height: 38, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 6); Visible: false; Label #AdmRowName9 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #AdmRowOwner9 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 2; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb3c6, VerticalAlignment: Center); Text: ""; } Label #AdmRowGrid9 { Anchor: (Height: 16, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8d9f, VerticalAlignment: Center); Text: ""; } $C.@SmallSecondaryTextButton #AdmRowTp9 { @Anchor = (Width: 70, Height: 28); Text: "Tp"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowTransfer9 { @Anchor = (Width: 90, Height: 28); Text: "Transfer"; } Group { Anchor: (Width: 4); } $C.@SmallSecondaryTextButton #AdmRowDelete9 { @Anchor = (Width: 80, Height: 28); Text: "Delete"; } }
        }

        Group {
          Anchor: (Horizontal: 0, Height: 36);
          LayoutMode: Left;

          $C.@SmallSecondaryTextButton #AdmPrev {
            @Anchor = (Width: 120, Vertical: 0);
            Text: "Prev";
          }

          Label #AdmPageLabel {
            Anchor: (Height: 18, Vertical: 0);
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #cbd9e8, HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "";
          }

          $C.@SmallSecondaryTextButton #AdmNext {
            @Anchor = (Width: 120, Vertical: 0);
            Text: "Next";
          }
        }
      }

      // ===== STATS PANEL =====
      Group #PanelStats {
        Visible: false;
        Anchor: (Horizontal: 0, Vertical: 0);
        LayoutMode: Top;

        Group {
          Anchor: (Horizontal: 0, Bottom: 12);
          LayoutMode: Top;
          Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4, Color: #0f1822);
          Padding: (Full: 10);

          Group {
            Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
            Label { Text: "Total Plots:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            Label #StatTotal { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
          }
          Group {
            Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
            Label { Text: "Claimed:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            Label #StatClaimed { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
          }
          Group {
            Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
            Label { Text: "Unclaimed:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            Label #StatUnclaimed { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
          }
          Group {
            Anchor: (Horizontal: 0, Height: 26, Bottom: 4); LayoutMode: Left; Padding: (Horizontal: 6);
            Label { Text: "Distinct Owners:"; Style: (FontSize: 13, TextColor: #7a8d9f, RenderBold: true, VerticalAlignment: Center); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
            Label #StatOwners { Text: ""; Style: (FontSize: 13, TextColor: #d0dce6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: End); Anchor: (Height: 20, Vertical: 0); FlexWeight: 1; }
          }
        }

        Label {
          Anchor: (Horizontal: 0, Height: 22, Bottom: 4);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #afc2c3, RenderBold: true);
          Text: "TOP OWNERS";
        }

        Label #StatTopEmpty {
          Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #d6a6a6);
          Text: "No data.";
          Visible: false;
        }

        Group {
          Anchor: (Horizontal: 0, Bottom: 4);
          FlexWeight: 1;
          LayoutMode: TopScrolling;
