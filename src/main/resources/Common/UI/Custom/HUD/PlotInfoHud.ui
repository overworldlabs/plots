Group #PlotInfoRoot {
  LayoutMode: Top;
  Anchor: (Left: 24, Bottom: 24, Width: 300, Height: 86);
  Visible: false;

  Group #PlotInfoBody {
    Anchor: (Width: 300, Height: 86);
    Background: (Color: #101820);
    Visible: false;

    Group {
      Anchor: (Left: 0, Top: 0, Bottom: 0, Width: 4);
      Background: (Color: #55ff7a);
    }

    Label #PlotName {
      Anchor: (Left: 16, Width: 272, Height: 24, Top: 10);
      Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start);
      Text: "";
    }

    Label #PlotOwner {
      Anchor: (Left: 16, Width: 272, Height: 20, Top: 36);
      Style: (FontSize: 12, TextColor: #c7d2da, HorizontalAlignment: Start);
      Text: "";
    }

    Label #PlotInfoLine {
      Anchor: (Left: 16, Width: 272, Height: 18, Top: 58);
      Style: (FontSize: 11, TextColor: #8fa3b3, HorizontalAlignment: Start);
      Text: "";
    }
  }

  Group #PlotFallback {
    Anchor: (Width: 300, Height: 44);
    Background: (Color: #101820);
    Visible: false;

    Label #PlotFallbackText {
      Anchor: (Width: 300, Height: 44, Top: 0);
      Style: (FontSize: 12, TextColor: #c7d2da, HorizontalAlignment: Center);
      Text: "";
    }
  }
}
