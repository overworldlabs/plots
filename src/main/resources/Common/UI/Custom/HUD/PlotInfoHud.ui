// Plot info HUD. Uses the SAME container widget/textures as the plot pages ($C.@Container from
// PlotsCommon.ui), laid out like the AeroWars scoreboard: a title bar, then rows separated by
// thin rules. The title bar carries the plot NAME (no generic "PLOT" caption), so the content
// area only holds owner/size and the Alt hint — everything below must fit in
// Height - @TitleHeight - vertical padding, otherwise the footer spills outside the panel.
// Position is unchanged — pinned to the bottom-left corner. Element ids stay in sync with
// PlotInfoHUD.java; the whole thing is shown/hidden by toggling #PlotInfoRoot.Visible.
$C = "../PlotsCommon.ui";

Group #PlotInfoRoot {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  Visible: false;

  $C.@Container #PlotBanner {
    Anchor: (Left: 16, Bottom: 96, Width: 244, Height: 196);
    Visible: false;

    // The plot name lives here — long names shrink instead of overflowing the header.
    #Title {
      $C.@Title #PlotHudTitle {
        @Text = "";
        Style: (...$C.@TitleStyle, RenderUppercase: false, TextColor: #ffffff, HorizontalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10, Wrap: false);
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Top: 14, Bottom: 14, Left: 16, Right: 16);

      Label #PlotOwnerTitle {
        Text: "";
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #878e9c, RenderUppercase: true, HorizontalAlignment: Start);
        Anchor: (Horizontal: 0, Height: 14, Top: 4);
      }
      Label #PlotOwnerValue {
        Text: "";
        Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
        Anchor: (Horizontal: 0, Height: 20, Top: 1);
      }

      Group #PlotHudRule2 { Anchor: (Horizontal: 0, Height: 1, Top: 10); Background: (Color: #ffffff1f); }

      Label #PlotSizeTitle {
        Text: "";
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #878e9c, RenderUppercase: true, HorizontalAlignment: Start);
        Anchor: (Horizontal: 0, Height: 14, Top: 9);
      }
      Label #PlotSizeValue {
        Text: "";
        Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start);
        Anchor: (Horizontal: 0, Height: 20, Top: 1);
      }

      // Flexible spacer pushes the footer to the bottom of the panel.
      Group { Anchor: (Horizontal: 0); FlexWeight: 1; }

      Group #PlotHudFooterRule { Anchor: (Horizontal: 0, Height: 1, Bottom: 6); Background: (Color: #ffffff14); }
      Label #PlotHudFooter {
        Text: "";
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #7ac0ff, RenderBold: true, HorizontalAlignment: Center);
        Anchor: (Horizontal: 0, Height: 16);
      }
    }
  }
}
