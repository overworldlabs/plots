Group #PlotInfoRoot {
  LayoutMode: Top;
  Anchor: (Top: 140, Width: 520, Height: 70);
  Visible: false;

  Group #PlotInfoBody {
    Anchor: (Width: 520, Height: 70);
    Background: (Color: #101820);
    Visible: false;

    Label #PlotName {
      Anchor: (Width: 520, Height: 24, Top: 4);
      Style: (
        FontSize: 15,
        TextColor: #ffffff,
        RenderBold: true,
        HorizontalAlignment: Center
      );
      Text: "";
    }

    Label #PlotOwner {
      Anchor: (Width: 520, Height: 20, Top: 28);
      Style: (
        FontSize: 12,
        TextColor: #c7d2da,
        HorizontalAlignment: Center
      );
      Text: "";
    }

    Label #PlotInfoLine {
      Anchor: (Width: 520, Height: 18, Top: 48);
      Style: (
        FontSize: 11,
        TextColor: #8fa3b3,
        HorizontalAlignment: Center
      );
      Text: "";
    }
  }

  Group #PlotFallback {
    Anchor: (Width: 520, Height: 44);
    Background: (Color: #101820);
    Visible: false;

    Label #PlotFallbackText {
      Anchor: (Width: 520, Height: 44, Top: 0);
      Style: (
        FontSize: 13,
        TextColor: #c7d2da,
        HorizontalAlignment: Center
      );
      Text: "";
    }
  }
}
